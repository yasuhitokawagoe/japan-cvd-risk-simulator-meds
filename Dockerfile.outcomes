# PC版（outcomes）アプリ用 Dockerfile
# Pythonバージョンを完全固定（scipy/numpy等のwheel相性問題を回避）
# ※開発環境(.venv)が Python 3.12.3 のため、固定した依存バージョンと整合する 3.12-slim を採用
#   （railway.md では 3.11 だったが、依存を現環境の版に固定するため 3.12 に合わせている）
FROM python:3.12-slim

WORKDIR /app

# Railway上でウィジェット再実行時にBLASが過剰にスレッドを生成するのを防ぐ。
# ネイティブライブラリの障害時はPythonスタックもログに残す。
ENV OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    PYTHONFAULTHANDLER=1

# 患者向けPDFへ正しい日本語字形を埋め込む。
# CFF形式のCJK OTFではなく、ReportLabが埋め込めるTrueType版を使用する。
ADD https://raw.githubusercontent.com/google/fonts/main/ofl/notosansjp/NotoSansJP%5Bwght%5D.ttf /usr/share/fonts/truetype/noto/NotoSansJP.ttf

# 依存だけ先にコピーしてインストール（レイヤーキャッシュを効かせる）
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# アプリ本体をコピー
COPY . .

# 起動するアプリ：既定はPC版（outcomes）。patient-facingサービスだけ
# APP_ENTRYPOINT=app_streamlit_patient.py を設定する。$PORT はRailwayが注入。
# ※ shell形式で書くこと。exec形式 CMD ["..."] だと $PORT が展開されない
CMD streamlit run ${APP_ENTRYPOINT:-app_streamlit_outcomes.py} --server.address 0.0.0.0 --server.port $PORT
